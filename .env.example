# Copy to .env (never committed). The Compose runtime (scripts/runtime-up.sh) writes its own .env
# from this file; the server .env is generated by infra-provision.yml and updated by the deploy workflow.

DB_NAME='cigarholic'
DB_USER='cigarholic'
DB_PASSWORD='cigarholic'
DB_HOST='db'
# DB_PREFIX='wp_'
# DATABASE_URL='mysql://user:password@host:3306/database'

# development | staging | production
WP_ENV='development'
WP_HOME='http://localhost:8080'
WP_SITEURL="${WP_HOME}/wp"

# Generate: https://roots.io/salts.html (the runtime and provisioning scripts generate random ones)
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Object cache (Valkey, Redis protocol)
WP_REDIS_HOST='cache'
WP_REDIS_PORT='6379'
WP_REDIS_PREFIX='cigarholic_dev'

# Outgoing mail in development: Mailpit traps everything (http://localhost:8025).
# On staging and production FluentSMTP sends through Postmark instead (token set by provisioning).
SMTP_HOST='mail'
SMTP_PORT='1025'
POSTMARK_SERVER_TOKEN=''

# Cloudflare Turnstile. These are Cloudflare's public always-pass test keys for development and CI.
TURNSTILE_SITE_KEY='1x00000000000000000000AA'
TURNSTILE_SECRET_KEY='1x0000000000000000000000000000000AA'

# Analytics (empty = tracking off)
GA4_MEASUREMENT_ID=''

# Feature toggles for cigarholic-core, comma separated, e.g. "signups:on,engraving:off"
CIGARHOLIC_FEATURES=''

# Optional overrides
# WP_DEBUG_LOG='/path/to/debug.log'
# WP_MEMORY_LIMIT='256M'
