# Dotenv: only the example is committed
.env
.env.*
!.env.example

# Composer
/vendor/

# WordPress core and Composer-managed plugins and themes
/web/wp/
/web/.htaccess
/web/app/plugins/*
!/web/app/plugins/.gitkeep
/web/app/mu-plugins/*/
/web/app/mu-plugins/*.php
!/web/app/mu-plugins/cigarholic-core/
!/web/app/mu-plugins/cigarholic-core.php
!/web/app/mu-plugins/.gitkeep
/web/app/themes/*
!/web/app/themes/.gitkeep
!/web/app/themes/cigarholic/
/web/app/upgrade/
/web/app/uploads/*
!/web/app/uploads/.gitkeep
/web/app/object-cache.php
/web/app/advanced-cache.php
/web/app/wp-cache-config.php

# Node
node_modules/

# Tooling output
/logs/
/.phpunit.cache/
/.phpcs-cache
/test-results/
/playwright-report/
/blob-report/
/.deployer/
/docker/data/
/docker/ca/*.crt
!/docker/ca/empty.crt

# Claude Code worktrees for subagents (created by the harness inside the checkout)
.claude/worktrees/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
/tools/
.phpstan-cache/
