{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "Base"
        },
        {
          "slug": "contrast",
          "color": "#1c1917",
          "name": "Contrast"
        },
        {
          "slug": "accent",
          "color": "#6b4a2e",
          "name": "Accent"
        },
        {
          "slug": "neutral-1",
          "color": "#f4f1ec",
          "name": "Neutral 1 (surface)"
        },
        {
          "slug": "neutral-2",
          "color": "#5b564f",
          "name": "Neutral 2 (muted text)"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system-sans",
          "name": "System sans-serif",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "system-serif",
          "name": "System serif",
          "fontFamily": "Georgia, \"Times New Roman\", Times, serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "fluid": false,
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          },
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.5rem"
          },
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "1.75rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.25rem"
          },
          "name": "Extra large"
        },
        {
          "slug": "xx-large",
          "size": "2.5rem",
          "fluid": {
            "min": "2rem",
            "max": "3.25rem"
          },
          "name": "Huge"
        }
      ],
      "textColumns": false,
      "writingMode": false
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.25rem",
          "name": "1"
        },
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "2"
        },
        {
          "slug": "30",
          "size": "0.75rem",
          "name": "3"
        },
        {
          "slug": "40",
          "size": "1rem",
          "name": "4"
        },
        {
          "slug": "50",
          "size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)",
          "name": "5"
        },
        {
          "slug": "60",
          "size": "clamp(1.75rem, 1.25rem + 2vw, 2.75rem)",
          "name": "6"
        },
        {
          "slug": "70",
          "size": "clamp(2.5rem, 1.5rem + 4vw, 4.5rem)",
          "name": "7"
        },
        {
          "slug": "80",
          "size": "clamp(3.5rem, 2rem + 6vw, 7rem)",
          "name": "8"
        }
      ],
      "units": [ "px", "rem", "em", "%", "vh", "vw" ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "soft",
          "name": "Soft",
          "shadow": "0 2px 12px rgba(28, 25, 23, 0.08)"
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/pullquote": {
        "typography": {
          "fontSizes": []
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|50",
      "padding": {
        "top": "0",
        "right": "var:preset|spacing|40",
        "bottom": "0",
        "left": "var:preset|spacing|40"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|contrast"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|contrast"
          }
        }
      },
      "button": {
        "border": {
          "radius": "2px",
          "width": "0"
        },
        "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|base"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|system-sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|accent",
            "text": "var:preset|color|base"
          }
        },
        ":focus": {
          "color": {
            "background": "var:preset|color|accent",
            "text": "var:preset|color|base"
          }
        },
        ":active": {
          "color": {
            "background": "var:preset|color|accent",
            "text": "var:preset|color|base"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|system-serif",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "700"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-sans",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-sans",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase"
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var:preset|color|contrast",
              "radius": "2px",
              "style": "solid",
              "width": "2px"
            },
            "color": {
              "background": "transparent",
              "text": "var:preset|color|contrast"
            },
            "spacing": {
              "padding": {
                "top": "calc(0.75rem - 2px)",
                "right": "calc(1.5rem - 2px)",
                "bottom": "calc(0.75rem - 2px)",
                "left": "calc(1.5rem - 2px)"
              }
            },
            ":hover": {
              "border": {
                "color": "var:preset|color|accent"
              },
              "color": {
                "background": "var:preset|color|accent",
                "text": "var:preset|color|base"
              }
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "500"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-serif",
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "700",
          "letterSpacing": "0.02em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-serif",
          "fontWeight": "600",
          "lineHeight": "1.2"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/query-pagination": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "core/search": {
        "border": {
          "color": "var:preset|color|neutral-2",
          "radius": "2px",
          "style": "solid",
          "width": "1px"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|neutral-1"
        }
      },
      "core/details": {
        "border": {
          "bottom": {
            "color": "var:preset|color|neutral-1",
            "style": "solid",
            "width": "1px"
          }
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|30",
            "bottom": "var:preset|spacing|30"
          }
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-serif",
          "fontSize": "var:preset|font-size|large",
          "fontStyle": "italic"
        },
        "border": {
          "left": {
            "color": "var:preset|color|accent",
            "style": "solid",
            "width": "3px"
          }
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-serif",
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.3"
        }
      },
      "core/list": {
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|50"
          }
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/product-button": {
        "border": {
          "radius": "2px"
        },
        "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|base"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "woocommerce/product-price": {
        "typography": {
          "fontWeight": "600"
        }
      },
      "woocommerce/product-sale-badge": {
        "border": {
          "radius": "2px"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|base"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "woocommerce/mini-cart": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "woocommerce/customer-account": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/breadcrumbs": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|neutral-2"
            }
          }
        }
      },
      "woocommerce/product-results-count": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/catalog-sorting": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/product-sku": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/product-stock-indicator": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "woocommerce/product-details": {
        "spacing": {
          "margin": {
            "top": "0"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
