{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "slug": "base",
          "color": "#eee9e0",
          "name": "Ash (page ground)"
        },
        {
          "slug": "neutral-1",
          "color": "#f7f4ef",
          "name": "Ash tint (cards, inputs, quiet sections)"
        },
        {
          "slug": "line",
          "color": "#d6cec1",
          "name": "Line (dividers only)"
        },
        {
          "slug": "neutral-2",
          "color": "#5e574e",
          "name": "Stone (muted text on light)"
        },
        {
          "slug": "contrast",
          "color": "#1a1815",
          "name": "Ink (text)"
        },
        {
          "slug": "accent",
          "color": "#9c5034",
          "name": "Cedar (links and buttons on light)"
        },
        {
          "slug": "forest",
          "color": "#1f2b25",
          "name": "Forest (dark sections)"
        },
        {
          "slug": "forest-2",
          "color": "#26342d",
          "name": "Forest raised (panels on Forest)"
        },
        {
          "slug": "mist",
          "color": "#cfc9be",
          "name": "Mist (muted text on Forest)"
        },
        {
          "slug": "gold",
          "color": "#c1904f",
          "name": "Gold (accent on Forest only)"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "hanken-grotesk",
          "name": "Hanken Grotesk",
          "fontFamily": "\"Hanken Grotesk\", \"Helvetica Neue\", Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/hanken-grotesk-latin-wght-normal.woff2"
              ]
            }
          ]
        },
        {
          "slug": "young-serif",
          "name": "Young Serif",
          "fontFamily": "\"Young Serif\", Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Young Serif",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/young-serif-latin-400-normal.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "x-small",
          "size": "0.75rem",
          "fluid": false,
          "name": "Label"
        },
        {
          "slug": "small",
          "size": "0.875rem",
          "fluid": false,
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.0625rem"
          },
          "name": "Body"
        },
        {
          "slug": "large",
          "size": "1.125rem",
          "fluid": {
            "min": "1.0625rem",
            "max": "1.25rem"
          },
          "name": "Lead"
        },
        {
          "slug": "x-large",
          "size": "1.5rem",
          "fluid": {
            "min": "1.375rem",
            "max": "1.625rem"
          },
          "name": "Heading 3"
        },
        {
          "slug": "xx-large",
          "size": "2.25rem",
          "fluid": {
            "min": "2rem",
            "max": "2.5rem"
          },
          "name": "Heading 2"
        },
        {
          "slug": "xxx-large",
          "size": "3.25rem",
          "fluid": {
            "min": "2.5rem",
            "max": "4rem"
          },
          "name": "Heading 1"
        }
      ],
      "textColumns": false,
      "writingMode": false
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "slug": "10",
          "size": "0.25rem",
          "name": "1"
        },
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "2"
        },
        {
          "slug": "30",
          "size": "0.75rem",
          "name": "3"
        },
        {
          "slug": "40",
          "size": "1rem",
          "name": "4"
        },
        {
          "slug": "50",
          "size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)",
          "name": "5"
        },
        {
          "slug": "60",
          "size": "clamp(1.75rem, 1.25rem + 2vw, 2.75rem)",
          "name": "6"
        },
        {
          "slug": "70",
          "size": "clamp(2.5rem, 1.5rem + 4vw, 4.5rem)",
          "name": "7"
        },
        {
          "slug": "80",
          "size": "clamp(3.5rem, 2rem + 6vw, 7rem)",
          "name": "8"
        }
      ],
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/pullquote": {
        "typography": {
          "fontSizes": []
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|hanken-grotesk",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.65"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|50",
      "padding": {
        "top": "0",
        "right": "clamp(1rem, 4vw, 2rem)",
        "bottom": "0",
        "left": "clamp(1rem, 4vw, 2rem)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var:preset|color|forest"
          }
        },
        ":focus": {
          "color": {
            "text": "var:preset|color|forest"
          }
        }
      },
      "button": {
        "border": {
          "radius": "3px",
          "width": "0"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "#ffffff"
        },
        "spacing": {
          "padding": {
            "top": "0.875rem",
            "right": "1.625rem",
            "bottom": "0.875rem",
            "left": "1.625rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|hanken-grotesk",
          "fontSize": "1rem",
          "fontWeight": "600",
          "lineHeight": "1.2",
          "textDecoration": "none"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|forest",
            "text": "var:preset|color|base"
          }
        },
        ":active": {
          "color": {
            "background": "var:preset|color|forest",
            "text": "var:preset|color|base"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|young-serif",
          "fontWeight": "400",
          "lineHeight": "1.15"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xxx-large",
          "lineHeight": "1.05",
          "letterSpacing": "-0.01em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large",
          "lineHeight": "1.15"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large",
          "lineHeight": "1.2"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var:preset|font-family|hanken-grotesk",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var:preset|font-family|hanken-grotesk",
          "fontSize": "var:preset|font-size|medium",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var:preset|font-family|hanken-grotesk",
          "fontSize": "var:preset|font-size|x-small",
          "fontWeight": "600",
          "letterSpacing": "0.24em",
          "lineHeight": "1.4",
          "textTransform": "uppercase"
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "blocks": {
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "var:preset|color|contrast",
              "radius": "3px",
              "style": "solid",
              "width": "1.5px"
            },
            "color": {
              "background": "transparent",
              "text": "var:preset|color|contrast"
            },
            "spacing": {
              "padding": {
                "top": "calc(0.875rem - 1.5px)",
                "right": "calc(1.625rem - 1.5px)",
                "bottom": "calc(0.875rem - 1.5px)",
                "left": "calc(1.625rem - 1.5px)"
              }
            },
            ":hover": {
              "border": {
                "color": "var:preset|color|contrast"
              },
              "color": {
                "background": "var:preset|color|contrast",
                "text": "var:preset|color|base"
              }
            }
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "0.9375rem",
          "fontWeight": "500"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|young-serif",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "letterSpacing": "-0.01em",
          "lineHeight": "1"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/site-tagline": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|young-serif",
          "fontWeight": "400",
          "lineHeight": "1.15"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|contrast"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/query-pagination": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "core/search": {
        "border": {
          "color": "var:preset|color|neutral-2",
          "radius": "3px",
          "style": "solid",
          "width": "1px"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|line"
        }
      },
      "core/details": {
        "border": {
          "bottom": {
            "color": "var:preset|color|line",
            "style": "solid",
            "width": "1px"
          }
        },
        "spacing": {
          "padding": {
            "top": "var:preset|spacing|30",
            "bottom": "var:preset|spacing|30"
          }
        }
      },
      "core/quote": {
        "typography": {
          "fontFamily": "var:preset|font-family|young-serif",
          "fontSize": "var:preset|font-size|large",
          "fontStyle": "normal"
        },
        "border": {
          "left": {
            "color": "var:preset|color|accent",
            "style": "solid",
            "width": "3px"
          }
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var:preset|font-family|young-serif",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "400",
          "lineHeight": "1.3"
        }
      },
      "core/list": {
        "spacing": {
          "padding": {
            "left": "var:preset|spacing|50"
          }
        }
      },
      "core/table": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/product-button": {
        "border": {
          "radius": "3px"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "#ffffff"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "woocommerce/product-price": {
        "typography": {
          "fontWeight": "600"
        }
      },
      "woocommerce/product-sale-badge": {
        "border": {
          "radius": "3px"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "#ffffff"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "woocommerce/mini-cart": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "woocommerce/customer-account": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/breadcrumbs": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        },
        "elements": {
          "link": {
            "color": {
              "text": "var:preset|color|neutral-2"
            }
          }
        }
      },
      "woocommerce/product-results-count": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/catalog-sorting": {
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/product-sku": {
        "color": {
          "text": "var:preset|color|neutral-2"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "woocommerce/product-stock-indicator": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "woocommerce/product-details": {
        "spacing": {
          "margin": {
            "top": "0"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "checkout-header",
      "title": "Checkout header",
      "area": "header"
    }
  ]
}
