{
  "name": "cuong-tran/cigarholic",
  "type": "project",
  "license": "proprietary",
  "description": "Cigarholic: WooCommerce store for handcrafted wooden humidors, Bedrock layout",
  "homepage": "https://cigarholic.com",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.3",
    "oscarotero/env": "^2.1",
    "roots/wordpress": "7.1.4",
    "roots/wp-config": "1.0.0",
    "vlucas/phpdotenv": "^5.6",
    "wpackagist-plugin/complianz-gdpr": "7.5.6",
    "wpackagist-plugin/fluent-smtp": "2.4.1",
    "wpackagist-plugin/redis-cache": "3.0.0",
    "wpackagist-plugin/stripe-tax-for-woocommerce": "2.2.0",
    "wpackagist-plugin/two-factor": "0.17.0",
    "wpackagist-plugin/webp-uploads": "2.7.1",
    "wpackagist-plugin/woocommerce": "11.2.1",
    "wpackagist-plugin/woocommerce-gateway-stripe": "11.1.1",
    "wpackagist-plugin/woocommerce-google-analytics-integration": "2.4.4",
    "wpackagist-plugin/woocommerce-paypal-payments": "4.2.0",
    "wpackagist-plugin/wp-seopress": "10.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "php-stubs/woocommerce-stubs": "^11.2",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "wp-phpunit/wp-phpunit": "7.1.3",
    "wpackagist-plugin/query-monitor": "4.1.1",
    "yoast/phpunit-polyfills": "^4.0 || ^3.1"
  },
  "replace": {
    "phpstan/phpstan": "2.3.4",
    "phpunit/phpunit": "11.5.57"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "roots/wordpress-core-installer": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.6"
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Cigarholic\\Core\\": "web/app/mu-plugins/cigarholic-core/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cigarholic\\Tests\\": "tests/phpunit/"
    }
  },
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "tools": "bash scripts/tools.sh",
    "lint": "parallel-lint --exclude vendor --exclude web/wp --exclude web/app/plugins --exclude node_modules --exclude tools .",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpstan": "tools/phpstan.phar analyse --memory-limit=1G",
    "test": "tools/phpunit.phar",
    "check": [
      "@composer validate --strict",
      "@lint",
      "@phpcs",
      "@phpstan"
    ]
  }
}
